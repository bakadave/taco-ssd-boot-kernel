#!/bin/busybox sh

# Set up essential environment
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

# Define a simple logging function
log() {
    /bin/busybox echo "$1" > /dev/kmsg
    /bin/busybox echo "$1"
}

# Function for emergency shell
goto_shell() {
    log "Boot process failed! Starting emergency shell..."
    log "Type 'exit' to reboot the system"
    exec /bin/busybox sh
}

# Function to create a default user
create_default_user() {
    log "Setting up default user..."
    echo 'pi:$6$6jHfJHIYZgxmYwXj$BUbiErwrKjzGzf1Ne/RlQ2bNLBdUs9KeywldWV6uYddLG1GYdZSwnu/UzJZVKJaUjJ30f3QbCsY5xQdaJRxZO.' > /mnt/boot/userconf.txt
}

# Function to create a user with preloaded credentials
create_preloaded_user() {
    log "Creating user from preloaded configuration..."
    /bin/busybox cp "/user_configs/userconf.txt" "/mnt/boot/userconf.txt"
    /bin/busybox chmod 600 "/mnt/boot/userconf.txt"
}

# Function to add SSH keys
add_ssh_keys() {
    log "Adding SSH keys to user..."

    # Mount root partition
    /bin/busybox mkdir -p /mnt/root
    /bin/busybox mount /dev/nvme0n1p2 /mnt/root

    SSH_DIR="/mnt/root/home/pi/.ssh"
    /bin/busybox mkdir -p "$SSH_DIR"
    /bin/busybox cat "/ssh_keys/id_rsa.pub" > "$SSH_DIR/authorized_keys"
    /bin/busybox chmod 700 "$SSH_DIR"
    /bin/busybox chmod 600 "$SSH_DIR/authorized_keys"
    /bin/busybox chown -R 1000:1000 "$SSH_DIR"

    # Unmount root partition
    /bin/busybox umount /mnt/root
}

# Initialize system
log "=== Radxa Taco kexec boot initializing ==="
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
log "Basic filesystems mounted"

# Load PCIe drivers
log "Loading PCIe drivers..."
/bin/busybox insmod /lib/modules/pcieport.ko 2>/dev/kmsg || log "Warning: pcieport module load error (may be built-in)"

# Give hardware time to initialize
log "Waiting for devices to settle..."
/bin/busybox sleep 3

# Check for NVMe drive
log "Looking for NVMe drive..."
if [ -b /dev/nvme0n1p1 ]; then
    log "Found NVMe drive!"

    # Create mount points
    /bin/busybox mkdir -p /mnt/boot
    /bin/busybox mkdir -p /mnt/root

    # Mount partitions - Bookworm typically has boot on p1, root on p2
    log "Mounting partitions..."
    /bin/busybox mount /dev/nvme0n1p1 /mnt/boot || {
        log "ERROR: Failed to mount boot partition!"
        goto_shell
    }

    # Get original cmdline
    if [ -f /mnt/boot/cmdline.txt ]; then
        ORIG_CMDLINE=$(/bin/busybox cat /mnt/boot/cmdline.txt)
        log "Original cmdline: $ORIG_CMDLINE"

        # Strip root= parameter if present and add our own (also handle whitespace)
        NEW_CMDLINE=$(/bin/busybox echo "$ORIG_CMDLINE" | /bin/busybox sed 's/root=[^ ]* / /g; s/root=[^ ]*$//g; s/  / /g')
        CMDLINE="$NEW_CMDLINE root=/dev/nvme0n1p2 rw"
    else
        # Default cmdline if none found
        log "No cmdline.txt found, using default..."
        CMDLINE="console=serial0,115200 console=tty1 root=/dev/nvme0n1p2 rootfstype=ext4 fsck.repair=yes rw rootwait"
    fi

    # Check if firstrun tasks are in order
    if /bin/busybox echo "$CMDLINE" | /bin/busybox grep -q "systemd.run=/boot/firstrun.sh"; then
        log "Detected image customized with Raspberry Pi Imager, not messing with users..."

        # Create flag file to indicate SSH is set up
        /bin/busybox touch /mnt/boot/ssh_setup_done
    elif [ ! -f /mnt/boot/ssh_setup_done ]; then
        log "No customized setup detected, setting up users..."
        
        # Copy userconf.txt if it exists, otherwise create the default pi user
        if [ -f "/user_configs/userconf.txt" ]; then
            create_preloaded_user
            if [ -f "/ssh_keys/id_rsa.pub" ]; then
                add_ssh_keys
            fi
        else
            create_default_user
        fi

        # Enable SSH
        /bin/busybox touch /mnt/boot/ssh

        # Create flag file to indicate SSH is set up
        /bin/busybox touch /mnt/boot/ssh_setup_done
        
        log "SSH setup complete"
    else
        log "SSH already set up, skipping configuration"
    fi

    # Display found kernel files for debugging
    log "Files in boot partition:"
    log "$(/bin/busybox ls -la /mnt/boot)"

    # Check for Raspberry Pi kernel
    if [ -f /mnt/boot/kernel8.img ]; then
        log "Found kernel8.img, preparing kexec..."
        KERNEL="/mnt/boot/kernel8.img"

        # Check for initramfs (bookworm might have one)
        if [ -f /mnt/boot/initrd.img ]; then
            log "Using initrd.img"
            INITRD="--initrd=/mnt/boot/initrd.img"
        elif [ -f /mnt/boot/initramfs.img ]; then
            log "Using initramfs.img"
            INITRD="--initrd=/mnt/boot/initramfs.img"
        else
            log "No initramfs found, continuing without it"
            INITRD=""
        fi

        log "Using cmdline: $CMDLINE"

        # Execute kexec
        log "Loading kernel with kexec..."
        /sbin/kexec --load "$KERNEL" $INITRD --command-line="$CMDLINE"

        if [ $? -eq 0 ]; then
            log "Kernel loaded successfully, executing kexec..."
            /bin/busybox sync
            /sbin/kexec -e

            # Should never get here unless kexec fails
            log "ERROR: kexec -e failed to boot!"
        else
            log "ERROR: kexec --load failed!"
        fi
    else
        log "ERROR: kernel8.img not found in boot partition!"
        log "Available files:"
        log "$(/bin/busybox ls -la /mnt/boot)"
    fi
else
    log "ERROR: NVMe drive not found!"
    log "Available block devices:"
    log "$(/bin/busybox ls -la /dev/nvme* 2>/dev/null)" || log "  No NVMe devices found!"
    log "$(/bin/busybox ls -la /dev/mmcblk* 2>/dev/null)" || log "  No eMMC devices found!"
fi

# If we get here, something went wrong
goto_shell
